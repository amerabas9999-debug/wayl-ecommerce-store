# Wayl API Configuration
WAYL_API_TOKEN=your_merchant_token_here
WAYL_API_URL=https://api.thewayl.com
WAYL_ENV=test

# Server Configuration
PORT=3000
NODE_ENV=development

# Webhook Configuration
WEBHOOK_SECRET=your_secure_webhook_secret_here
WEBHOOK_URL=https://your-domain.com/webhooks/wayl

# Store Configuration
STORE_NAME=My Ecommerce Store
STORE_URL=https://your-domain.com
REDIRECT_URL=https://your-domain.com/success
